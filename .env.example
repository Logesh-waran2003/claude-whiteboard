# Copy to .env (git-ignored) and adjust.
# Folder Claude may read to ground diagrams (read-only). Default: this repo.
WB_CODE_DIR=~/code
# Optional notes folder (e.g. an Obsidian vault), read-only.
# WB_NOTES_DIR=~/notes
# Board file. Default: .board/main.canvas
# WB_BOARD=.board/main.canvas
# PORT=8792
# WB_MODEL=claude-opus-5-5
# WB_EFFORT=high  (low | medium | high | xhigh | max)
